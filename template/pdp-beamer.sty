\definecolor{pdpNavy}{HTML}{0F172A}
\definecolor{pdpTeal}{HTML}{0F766E}
\definecolor{pdpMint}{HTML}{CCFBF1}
\definecolor{pdpAmber}{HTML}{F59E0B}
\definecolor{pdpSlate}{HTML}{334155}
\definecolor{pdpBg}{HTML}{F8FAFC}
\definecolor{pdpLine}{HTML}{CBD5E1}
\definecolor{pdpSoftTeal}{HTML}{ECFDF5}
\definecolor{pdpSoftAmber}{HTML}{FFF7ED}

\setbeamercolor{normal text}{fg=pdpNavy,bg=pdpBg}
\setbeamercolor{frametitle}{fg=pdpNavy,bg=pdpBg}
\setbeamercolor{title}{fg=pdpNavy}
\setbeamercolor{subtitle}{fg=pdpTeal}
\setbeamercolor{block title}{fg=white,bg=pdpTeal}
\setbeamercolor{block body}{fg=pdpNavy,bg=white}
\setbeamercolor{alerted text}{fg=pdpAmber!85!black}
\setbeamerfont{title}{series=\bfseries,size=\Large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
