\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\color{pdpTeal}$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{pdpAmber}$\bullet$}
\setbeamersize{text margin left=.65cm,text margin right=.65cm}

\newcommand{\pdpfooter}[2]{%
\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
  \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.55ex,dp=1.05ex,leftskip=.65cm]{author in head/foot}%
    \scriptsize Tim Pengajar PDP
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.40\paperwidth,ht=2.55ex,dp=1.05ex,center]{title in head/foot}%
    \scriptsize #1
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.26\paperwidth,ht=2.55ex,dp=1.05ex,rightskip=.65cm plus1fil]{date in head/foot}%
    \scriptsize Rifky Fauzi\hfill\insertframenumber/\inserttotalframenumber
  \end{beamercolorbox}}\vskip0pt% 
}}

\newcommand{\pdporangeline}{\vspace{0.15em}\textcolor{pdpAmber}{\rule{0.9cm}{1.3pt}}\vspace{0.35em}}
\newcommand{\pdpnote}[1]{{\scriptsize\color{pdpSlate}#1}}
\newcommand{\pdpkey}[1]{\textbf{\color{pdpTeal}#1}}
\newcommand{\pdpsource}[1]{{\fontsize{5.5}{6.2}\selectfont\color{pdpSlate}#1}}
\newcommand{\pdppill}[1]{\tikz[baseline=(X.base)]\node[fill=pdpMint,draw=pdpTeal,rounded corners=3pt,inner xsep=5pt,inner ysep=2pt](X){\scriptsize\bfseries #1};}

